# Supabase shared transaction pooler connection. Keep this server-side only.
POSTGRES_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres"
# Small shared per-runtime pool. Keep 5 on Vercel; isolated PGlite tests use 1.
POSTGRES_POOL_MAX=5
# Required for local database use. Set to `staging` only with both verified Supabase project references.
DATABASE_TARGET=
STAGING_SUPABASE_PROJECT_REF=
PRODUCTION_SUPABASE_PROJECT_REF=
APP_ORIGIN=http://localhost:3000
# Set true only when served over HTTPS.
COOKIE_SECURE=false
# Phase 1 allows handshakes before the event for demonstrations.
DEMO_HANDSHAKE_ANYTIME=true
# Provisional Phase 2 capabilities stay off unless explicitly enabled.
FEATURE_BOOKING_MESSAGING=false
FEATURE_PROVIDER_CANCELLATION_POLICY=false
PROVIDER_CANCELLATION_LOCK_HOURS=48
FEATURE_LOYALTY_BETA=false
FEATURE_LOYALTY_MONETARY_REWARDS=false
FEATURE_SIMULATED_DEPOSITS=false
# Set a random secret (at least 16 characters) only when activating the scheduled job.
# CRON_SECRET=
