{
  "name": "event-marketplace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx database/manage.ts migrate",
    "db:seed": "tsx database/manage.ts seed",
    "db:reset": "tsx database/manage.ts reset",
    "test:smoke": "tsx tests/smoke.ts",
    "test:e2e": "playwright test",
    "test:serve": "tsx tests/serve.ts",
    "format": "prettier --write app components config database features lib server tests types *.ts *.mjs *.json",
    "format:check": "prettier --check app components config database features lib server tests types *.ts *.mjs *.json"
  },
  "dependencies": {
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
